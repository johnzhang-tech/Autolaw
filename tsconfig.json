{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vitest/globals", "@testing-library/jest-dom"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,

    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "vitest.config.ts", "vite.config.ts"],

  // Figma Make leftovers, all deleted in Task 13 of the site rebuild plan. They are
  // excluded rather than fixed because they cannot type-check by design: they import
  // "package@version" specifiers that resolve only through vite.config.ts's alias map,
  // which TypeScript does not consult. Delete these three lines along with the files.
  "exclude": ["src/App.tsx", "src/imports", "src/components/ui", "src/components/figma"]
}
