# Build config for the production site. Vite reads this file for `vite build` only, so dev
# servers and the test suite never count a visit. Nothing secret belongs here: every value
# below ends up in the public JavaScript.
#
# The Umami Cloud website id for www.autolaw.ai, from Umami: Settings > Websites > the
# autolaw.ai website > Edit > Website ID. Paste the bare UUID, nothing around it.
# Empty means no tracker loads and nothing is sent; src/config.ts explains the rest.
VITE_UMAMI_WEBSITE_ID=
